{
  "name": "@mufucloud/shopify-app-kit",
  "version": "0.1.0",
  "description": "Shared server helpers for mufucloud Shopify apps: plan checks with Shopify App Pricing (Partner API + Billing API), shop metafields, revenue web pixel, discount lookup and Klaviyo signup.",
  "license": "MIT",
  "author": "mufucloud",
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/MUFU-Cloud/shopify-app-kit.git" },
  "keywords": ["shopify", "shopify-app", "app-pricing", "partner-api", "billing", "metafields", "web-pixel", "klaviyo"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=20.19" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "typescript": "^5.9.3"
  }
}
